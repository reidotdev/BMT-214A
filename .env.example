# Copy to .env.local and fill in. `pnpm scaffold` wires most of these for you.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
#
# Write values BARE — no quotes. `dotenv` strips quotes when Next.js reads this
# file, so `KEY="abc"` works locally and hides the problem; `vercel env add`
# does not strip them, so the quotes reach the deployed build as part of the
# value. See gotcha 9 in CLAUDE.md and docs/deploy.md.

# --- Sanity ---
# Project id: lowercase letters, digits and dashes only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Server-only token for drafts / live preview (Sanity → API → Tokens, Viewer role).
# `pnpm scaffold` can mint this for you.
SANITY_API_READ_TOKEN=

# --- Site ---
# The canonical production URL (used for metadata, sitemap, robots, OG image).
# Keep localhost here for local work — the scaffolder will not push a localhost
# value to Vercel's preview or production environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
