# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# storybook (`pnpm build-storybook` output — deployed, never committed)
/storybook-static/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# sanity typegen artifacts (regenerate with `pnpm typegen`)
schema.json
sanity.types.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code worktrees (nested git worktrees, never commit)
.claude/worktrees/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Source media. Keep video and other large assets OUT of git — a hero
# background lives in the history forever and is never worth it. Upload to
# Vercel Blob or Sanity and reference the URL. Remove this rule deliberately
# if a project really must ship a file from the repo.
/public/video/
